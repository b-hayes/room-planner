# Daily backup of Room Planner (data/ + prod.env) to /array/backup.
# Runs as the host user (container runs as UID 1000; no root needed).
# Install: sed "s/__USER__/$USER/" deploy/room-planner-backup | sudo tee /etc/cron.d/room-planner-backup
8 2 * * * __USER__ $HOME/repo/room-planner/bin/backup.sh >> $HOME/repo/room-planner/backup.log 2>&1
